#!/usr/bin/env bash
# Operator CLI for CKB AI Bench: setup, stack lifecycle, harness tests, live smoke/run, teardown.
#
# Day-1 (from repo root; ./bench is the primary entrypoint):
#   ./bench setup
#   ./bench test
#   ./bench up
#   ./bench status
#   ./bench smoke --profile gpt-5.6-luna
#   ./bench reset
#
# LLM proxy default: http://localhost:18321/v1
# Prefer this CLI over raw run-matrix.sh for live runs (shared lock + preflight).

# FIRST executable statement, before any path, .env value, endpoint or credential is resolved or
# expanded: under `bash -x` (or an inherited xtrace) Bash would otherwise trace the `.env`
# assignments as `source` runs, and every later redaction happens too late to help.
# `SHELLOPTS` is exported by some shells, so it is cleared too rather than only calling `set +x`.
set +x
unset -v SHELLOPTS BASH_XTRACEFD 2>/dev/null || true

set -euo pipefail

# Resolve repo root whether invoked as ./bench, scripts/ckbbench, or via PATH.
_SRC="${BASH_SOURCE[0]}"
while [[ -L "$_SRC" ]]; do
  _DIR="$(cd "$(dirname "$_SRC")" && pwd)"
  _SRC="$(readlink "$_SRC")"
  [[ "$_SRC" != /* ]] && _SRC="$_DIR/$_SRC"
done
REPO="$(cd "$(dirname "$_SRC")/.." && pwd)"
cd "$REPO"

# shellcheck disable=SC1091
[[ -f "$REPO/.env" ]] && set -a && source "$REPO/.env" && set +a

export COMPOSE_PROJECT_NAME=ckbbench
COMPOSE_FILE="$REPO/containers/compose.yml"
COMPOSE=(docker compose -f "$COMPOSE_FILE" -p ckbbench)

PY="${CKBBENCH_PYTHON:-$REPO/agent/.venv/bin/python}"
export PYTHONPATH="${PYTHONPATH:+${PYTHONPATH}:}$REPO/agent"

LLM_BASE="${CKBBENCH_LLM_API_BASE:-${BENCH_API_BASE:-http://localhost:18321/v1}}"
MCP_URL="${CKBBENCH_MCP_URL:-${MCP_URL:-https://mcp.ckbdev.com/ckbai}}"
MCP_VER="${CKBBENCH_MCP_VERSION:-${MCP_PINNED_VERSION:-1.6.13}}"
DEVNET_RPC="${CKBBENCH_DEVNET_RPC:-http://127.0.0.1:8114}"
# MCP_DISABLE=1 → status/smoke SKIP MCP checks
MCP_DISABLE="${CKBBENCH_MCP_DISABLE:-0}"

WORK_VOL="${CKBBENCH_WORK_VOLUME:-ckbbench-work}"
CARGO_VOL="${CKBBENCH_CARGO_VOLUME:-ckbbench-cargo-cache}"
DEVNET_WAIT_SECS="${CKBBENCH_DEVNET_WAIT_SECS:-120}"
OUTPUT_ROOT="$REPO/benchmark-output"

die() { echo "FAIL: $*" >&2; exit 1; }
info() { echo "$*"; }

pinned_python_version() {
  awk '$1=="python"{print $2}' "$REPO/.tool-versions" 2>/dev/null
}

# One advisory lock for the whole project, shared with containers/validate.sh.
# shellcheck source=lib/lock.sh
source "$REPO/scripts/lib/lock.sh"

compose_ok() {
  if [[ -n "${COMPOSE_PROJECT_NAME:-}" && "$COMPOSE_PROJECT_NAME" != "ckbbench" ]]; then
    die "COMPOSE_PROJECT_NAME is '$COMPOSE_PROJECT_NAME' (must be ckbbench or unset)"
  fi
  command -v docker >/dev/null || die "docker not found"
  docker compose version >/dev/null 2>&1 || die "docker compose not available"
}

agent_containers() {
  # Ephemeral agent containers on the internal net (never compose stack services).
  docker ps -q --filter "name=^minisweagent-" 2>/dev/null || true
}

refuse_if_agents_running() {
  local ids
  ids="$(agent_containers)"
  if [[ -n "$ids" ]]; then
    die "agent containers still running (minisweagent-*). Wait for the run or stop them; refuse destructive cleanup"
  fi
}

container_running() {
  local name="$1"
  local st
  st="$(docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null || echo false)"
  [[ "$st" == "true" ]]
}

devnet_rpc_ok() {
  # Host URL only — same endpoint the harness uses (CKBBENCH_DEVNET_RPC).
  # Do not fall back to in-docker probes: that greened status while host RPC was dead.
  curl -fsS -m 3 -X POST "$DEVNET_RPC" \
    -H 'Content-Type: application/json' \
    -d '{"jsonrpc":"2.0","id":1,"method":"get_tip_block_number","params":[]}' \
    2>/dev/null | grep -q result
}

devnet_rpc_call() {
  curl -fsS -m 5 -X POST "$DEVNET_RPC" \
    -H 'Content-Type: application/json' \
    -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"$1\",\"params\":${2:-[]}}" 2>/dev/null
}

devnet_is_ckb_dev() {
  devnet_rpc_call get_blockchain_info | grep -q '"chain":"ckb_dev"'
}

devnet_miner_advancing() {
  # A node answering RPC is not a ready DevNet: without a progressing miner a cell hangs on
  # commitment. Two reads a second apart must differ.
  local first second
  first="$(devnet_rpc_call get_tip_block_number)" || return 1
  sleep 2
  second="$(devnet_rpc_call get_tip_block_number)" || return 1
  [[ -n "$first" && -n "$second" && "$first" != "$second" ]]
}

# Removal goes through the Python lifecycle controller so there is ONE destructive path with the
# ownership/label checks, instead of a weaker `docker volume rm` here.
devnet_remove_data_volume() {
  [[ -x "$PY" ]] || die "python venv missing; run ./bench setup"
  "$PY" -m ckbbench.run.devnet --remove-data-volume
}

llm_readiness() {
  # Delegates to the harness so the readiness request uses the SAME credential precedence as the
  # production model. The key is never an argument: the helper reads it from the environment this
  # process already has, so it cannot appear in argv or in another user's `ps` output.
  # Neither the endpoint nor the credential is an argument. A configured base can itself carry
  # userinfo or a token, and argv is world-readable through `ps`; both cross this boundary in the
  # environment the child already inherits. The helper validates the base before using or showing it.
  CKBBENCH_LLM_API_BASE="$LLM_BASE" "$PY" -m ckbbench.run.llm_readiness 2>/dev/null
}

mcp_preflight() {
  if [[ "$MCP_DISABLE" == "1" ]]; then
    return 2  # skip
  fi
  [[ -x "$PY" ]] || return 1
  "$PY" - <<PY
import sys
sys.path.insert(0, "$REPO/agent")
from ckbbench.run.preflight import preflight_mcp, PreflightError
try:
    r = preflight_mcp("$MCP_URL", "$MCP_VER")
    print(f"ok version={r.server_version} tools={r.tool_count}")
except PreflightError as e:
    print(f"error: {e}", file=sys.stderr)
    sys.exit(1)
except Exception as e:
    print(f"error: {e}", file=sys.stderr)
    sys.exit(1)
PY
}

# --- command implementations (no re-lock) ---

cmd_setup() {
  info "== setup =="
  if ! command -v uv >/dev/null 2>&1; then
    die "uv not found (install: https://docs.astral.sh/uv/)"
  fi
  local pinned_python
  pinned_python="$(pinned_python_version)"
  [[ -n "$pinned_python" ]] || die "cannot read the python pin from .tool-versions"
  if [[ ! -d "$REPO/agent/.venv" ]]; then
    # EXACT pin, not the 3.12 series: the suite freeze records this interpreter as provenance, so
    # a 3.12.x that merely satisfies the major.minor would make that record false.
    info "creating agent/.venv (python $pinned_python)"
    (cd "$REPO/agent" && uv venv --python "$pinned_python" .venv)
  else
    local have
    have="$("$REPO/agent/.venv/bin/python" -c 'import platform;print(platform.python_version())' 2>/dev/null || true)"
    if [[ "$have" != "$pinned_python" ]]; then
      info "recreating agent/.venv (python ${have:-unknown} -> $pinned_python)"
      (cd "$REPO/agent" && uv venv --clear --python "$pinned_python" .venv)
    fi
  fi
  info "installing agent + harness deps"
  (cd "$REPO/agent" && uv pip install --python .venv/bin/python -r spike-requirements.txt)
  (cd "$REPO/agent" && uv pip install --python .venv/bin/python -e "..[dev]")
  if [[ ! -f "$REPO/.env" ]]; then
    cp "$REPO/.env.example" "$REPO/.env"
    info "created .env from .env.example (edit if you need non-defaults)"
  else
    info ".env already present"
  fi
  info ""
  info "live defaults:"
  # Setup echoes configuration back; the base is shown only once it validates, so a pasted
  # credential-bearing value cannot be reprinted here.
  info "  LLM:    $(llm_endpoint_display)"
  info "  MCP:    $MCP_URL (pin $MCP_VER)"
  info "  DevNet: $DEVNET_RPC"
  info "  Docker path: set via smoke/run or CKBBENCH_DOCKER=1"
  info "setup OK"
}

down_impl() {
  compose_ok
  info "== down (compose stack) =="
  "${COMPOSE[@]}" down --remove-orphans || return $?
  info "down OK"
  return 0
}

clean_impl() {
  local caches="${1:-0}"
  compose_ok
  info "== clean (agent leftovers only) =="
  refuse_if_agents_running

  # Remove stopped minisweagent leftovers (not compose services)
  local cid
  while read -r cid; do
    [[ -z "$cid" ]] && continue
    local name
    name="$(docker inspect -f '{{.Name}}' "$cid" 2>/dev/null | sed 's#^/##')"
    if [[ "$name" == minisweagent-* ]]; then
      info "removing leftover container $name"
      docker rm -f "$cid" >/dev/null 2>&1 || true
    fi
  done < <(docker ps -aq --filter "name=minisweagent" 2>/dev/null || true)

  # Match Python cleanup: only remove ckbbench-* named volumes (never arbitrary env values).
  [[ "$WORK_VOL" == ckbbench-* ]] || die "refusing non-ckbbench work volume: $WORK_VOL"
  docker volume rm -f "$WORK_VOL" >/dev/null 2>&1 || true
  info "removed volume $WORK_VOL (if present)"
  if [[ "$caches" == "1" ]]; then
    [[ "$CARGO_VOL" == ckbbench-* ]] || die "refusing non-ckbbench cargo volume: $CARGO_VOL"
    docker volume rm -f "$CARGO_VOL" >/dev/null 2>&1 || true
    info "removed volume $CARGO_VOL (if present)"
  fi

  local runs_dir=/tmp/ckbbench-runs
  if [[ -L "$runs_dir" ]]; then
    die "refuse host run-dir wipe: $runs_dir is a symlink"
  fi
  if [[ -d "$runs_dir" ]]; then
    if [[ -n "$(agent_containers)" ]]; then
      die "refuse host run-dir wipe: agent containers still running"
    fi
    rm -rf "${runs_dir:?}"/*
    info "cleared /tmp/ckbbench-runs/*"
  fi

  find "$REPO/containers/proxy" -maxdepth 1 -type f -name 'allowlist.*.built' \
    ! -name 'allowlist.observe' -delete 2>/dev/null || true
  info "cleared proxy allowlist.*.built temps"
  info "clean OK"
  return 0
}

safe_wipe_smoke_dir() {
  local target="$OUTPUT_ROOT/smoke"
  if [[ ! -e "$target" ]]; then
    mkdir -p "$target"
    return 0
  fi
  if [[ -L "$target" ]]; then
    die "benchmark-output/smoke is a symlink; refusing to wipe (path: $target)"
  fi
  if [[ ! -d "$target" ]]; then
    die "benchmark-output/smoke exists but is not a directory"
  fi
  local real repo_real
  real="$(realpath "$target")"
  repo_real="$(realpath "$OUTPUT_ROOT/smoke")"
  if [[ "$real" != "$repo_real" ]]; then
    die "benchmark-output/smoke realpath mismatch: $real != $repo_real"
  fi
  if [[ -L "$OUTPUT_ROOT" ]]; then
    die "benchmark-output/ is a symlink; refusing wipe"
  fi
  rm -rf "${target:?}"/*
  info "wiped $target contents"
}

cmd_up() {
  local no_build=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-build) no_build=1; shift ;;
      -h|--help) info "usage: ckbbench up [--no-build]"; return 0 ;;
      *) die "up: unknown arg $1" ;;
    esac
  done
  with_lock "up"
  compose_ok
  info "== up =="

  # Observe allowlist for multi-arm proxy stack (harness still builds per-cell allowlists for scoring)
  local observe="$REPO/containers/proxy/allowlist.observe"
  [[ -f "$observe" ]] || die "missing $observe"
  export CKBBENCH_ALLOWLIST_FILE="$observe"
  printf 'CKBBENCH_ALLOWLIST_FILE=%s\n' "$observe" >"$REPO/containers/.env.arm"

  if [[ "$no_build" -eq 0 ]]; then
    info "building images (docker cache)"
    # Repo-root context: agent + verifier Dockerfiles COPY suites/ and containers/bake/.
    docker build -f "$REPO/containers/agent.Dockerfile" -t ckbbench-agent:latest "$REPO"
    docker build -f "$REPO/containers/verifier.Dockerfile" -t ckbbench-verifier:latest "$REPO"
    docker build -f "$REPO/containers/proxy/proxy.Dockerfile" -t ckbbench-proxy:latest "$REPO/containers/proxy"
    "${COMPOSE[@]}" build
  else
    info "skipping image build (--no-build)"
  fi

  info "starting proxy"
  "${COMPOSE[@]}" up -d ckbbench-proxy
  # DevNet goes through the lifecycle controller's non-destructive start: a first `up` on a machine
  # with no state volume needs the create/chown/start sequence (a fresh named volume is root-owned
  # while the node runs as ckb), and readiness means chain identity plus a progressing miner.
  info "starting devnet (retains existing chain state)"
  [[ -x "$PY" ]] || die "python venv missing; run ./bench setup"
  "$PY" -m ckbbench.run.devnet --start || die "devnet did not become ready"

  # The controller already proved RPC, chain identity, miner progress and indexer readiness.
  info "up OK (proxy/MCP readiness: ./bench status)"
  release_lock
  return 0
}

cmd_down() {
  with_lock "down"
  down_impl
  release_lock
}

cmd_clean() {
  local caches=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --caches) caches=1; shift ;;
      -h|--help) info "usage: ckbbench clean [--caches]"; return 0 ;;
      *) die "clean: unknown arg $1" ;;
    esac
  done
  with_lock "clean"
  clean_impl "$caches"
  release_lock
}

cmd_reset() {
  local caches=0 wipe=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --caches) caches=1; shift ;;
      --wipe-out) wipe=1; shift ;;
      -h|--help) info "usage: ckbbench reset [--caches] [--wipe-out]"; return 0 ;;
      *) die "reset: unknown arg $1" ;;
    esac
  done
  with_lock "reset"
  local rc=0
  down_impl || rc=$?
  clean_impl "$caches" || rc=$?
  # Chain state is the point of a reset: without this, `reset` stopped the stack and kept every
  # prior cell's transactions. Only the inspected, benchmark-owned volume is removed.
  info "== removing DevNet chain state =="
  devnet_remove_data_volume || rc=$?
  if [[ "$wipe" -eq 1 ]]; then
    safe_wipe_smoke_dir || rc=$?
  fi
  if [[ "$rc" -eq 0 ]]; then
    info "reset OK (pristine runtime)"
  else
    info "reset finished with errors (exit $rc)"
  fi
  release_lock
  return "$rc"
}

# One evaluation pass shared by `status` and the live preflight. The printed lines and the return
# code come from the SAME observations, so a live run can no longer check the endpoint twice: the
# old preflight called cmd_status and then repeated its required subset.
#
# $1: 1 to require MCP, 0 to skip it (B-only live paths). CKBBENCH_MCP_DISABLE=1 still skips.
readiness_checks() {
  local need_mcp="${1:-1}"
  local fails=0
  local line pinned_python have_python

  # venv
  pinned_python="$(pinned_python_version)"
  have_python="$("$PY" -c 'import platform, ckbbench, pytest; print(platform.python_version())' 2>/dev/null || true)"
  if [[ -n "$pinned_python" && "$have_python" == "$pinned_python" ]]; then
    info "PASS  venv (Python $have_python; ckbbench + pytest importable)"
  else
    info "FAIL  venv (requires Python ${pinned_python:-unknown}; run: ./bench setup)"
    READINESS_FAILS=1
    return 1
  fi

  # compose required services running
  local svc
  for svc in ckbbench-proxy ckbbench-devnet-node ckbbench-devnet-miner; do
    if container_running "$svc"; then
      info "PASS  container $svc running"
    else
      info "FAIL  container $svc not running (./bench up)"
      fails=$((fails + 1))
    fi
  done

  # devnet RPC, chain identity and miner progress: a node that answers but is the wrong chain or
  # has a stalled miner is not a usable DevNet.
  if devnet_rpc_ok; then
    info "PASS  devnet RPC ($DEVNET_RPC)"
    if devnet_is_ckb_dev; then
      info "PASS  devnet chain is ckb_dev"
    else
      info "FAIL  devnet chain is not ckb_dev"
      fails=$((fails + 1))
    fi
    if devnet_miner_advancing; then
      info "PASS  devnet miner advancing"
    else
      info "FAIL  devnet miner not advancing"
      fails=$((fails + 1))
    fi
  else
    info "FAIL  devnet RPC ($DEVNET_RPC)"
    fails=$((fails + 1))
  fi

  # LLM readiness: exactly one authenticated request, classified for the operator.
  set +e
  line="$(llm_readiness)"
  local lrc=$?
  set -e
  if [[ $lrc -eq 0 ]]; then
    info "PASS  LLM proxy $line"
  else
    info "FAIL  LLM proxy ${line:-check failed}"
    fails=$((fails + 1))
  fi

  # MCP
  if [[ "$MCP_DISABLE" == "1" ]]; then
    info "SKIP  MCP (CKBBENCH_MCP_DISABLE=1)"
  elif [[ "$need_mcp" -ne 1 ]]; then
    info "SKIP  MCP (arms need no MCP surface)"
  else
    set +e
    line="$(mcp_preflight 2>&1)"
    local mrc=$?
    set -e
    if [[ $mrc -eq 0 ]]; then
      info "PASS  MCP ($MCP_URL) $line"
    else
      info "FAIL  MCP ($MCP_URL) $line"
      fails=$((fails + 1))
    fi
  fi

  # volumes / host leftovers (informational)
  if docker volume inspect "$WORK_VOL" >/dev/null 2>&1; then
    info "INFO  volume $WORK_VOL present"
  fi
  if docker volume inspect "$CARGO_VOL" >/dev/null 2>&1; then
    info "INFO  volume $CARGO_VOL present"
  fi
  if [[ -d /tmp/ckbbench-runs ]] && [[ -n "$(ls -A /tmp/ckbbench-runs 2>/dev/null || true)" ]]; then
    info "INFO  host run dirs under /tmp/ckbbench-runs"
  fi

  READINESS_FAILS="$fails"
  [[ "$fails" -eq 0 ]]
}

cmd_status() {
  local fails=0
  readiness_checks 1 || true
  fails="$READINESS_FAILS"

  if [[ "$fails" -gt 0 ]]; then
    info "status: $fails FAIL"
    return 1
  fi
  info "status: all required checks PASS"
  return 0
}

cmd_test() {
  local docker=0
  local extra=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --docker) docker=1; shift ;;
      --cov) shift ;; # ignore; we default --no-cov
      -h|--help) info "usage: ckbbench test [--docker]"; return 0 ;;
      *) extra+=("$1"); shift ;;
    esac
  done
  # No project lock here: containers/validate.sh takes it around its own Docker work, so the
  # docker-free layers do not block other operations and there is no nested lock to hand down.
  if [[ "$docker" -eq 1 ]]; then
    export CKBBENCH_DOCKER=1
  fi
  info "== test (harness) =="
  set +e
  bash "$REPO/scripts/test.sh" --no-cov "${extra[@]+"${extra[@]}"}"
  local rc=$?
  set -e
  return "$rc"
}

preflight_live() {
  local need_mcp="${1:-1}"
  info "== preflight =="
  # One pass, not a report followed by a repeat of the same required subset: the endpoint and the
  # MCP server are each contacted exactly once per operator invocation.
  if ! readiness_checks "$need_mcp"; then
    die "preflight failed ($READINESS_FAILS checks). Fix with: ./bench status && ./bench up"
  fi
  info "preflight OK"
}

# Resolve the selected profile before any lock, preflight or external seam, so readiness checks the
# endpoint and provider credential the cell will actually use.
# Read once from the COMPLETE forwarded vector. The optional `--` separator must not change what
# the wrapper knows, or preflight would check one endpoint while the launch used another.
scan_launch_args() {
  LAUNCH_SUITE=""; LAUNCH_MODELS=""; LAUNCH_PROFILE=""; LAUNCH_ARMS=""; LAUNCH_DRY=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --suite) LAUNCH_SUITE="${2:-}"; shift 2 ;;
      --suite=*) LAUNCH_SUITE="${1#*=}"; shift ;;
      --models) LAUNCH_MODELS="${2:-}"; shift 2 ;;
      --models=*) LAUNCH_MODELS="${1#*=}"; shift ;;
      --model-profile|--profile) LAUNCH_PROFILE="${2:-}"; shift 2 ;;
      --model-profile=*|--profile=*) LAUNCH_PROFILE="${1#*=}"; shift ;;
      --arms) LAUNCH_ARMS="${2:-}"; shift 2 ;;
      --arms=*) LAUNCH_ARMS="${1#*=}"; shift ;;
      --dry-run) LAUNCH_DRY=1; shift ;;
      *) shift ;;
    esac
  done
}

is_phase_one_suite() {
  # One authority decides what the phase-one registry is, so the wrapper and the launcher cannot
  # disagree about which run is allowed to spend a model call.
  [[ -n "$1" ]] || return 1
  "$PY" -c 'import sys
from ckbbench.matrix.launch import is_phase_one_suite
sys.exit(0 if is_phase_one_suite(sys.argv[1]) else 1)' "$1" 2>/dev/null
}

llm_endpoint_display() {
  CKBBENCH_LLM_API_BASE="$LLM_BASE" "$PY" -c 'import sys
from ckbbench.config import resolve_llm_api_base
from ckbbench.run.model_profile import ModelProfileError, safe_api_base
try:
    print(safe_api_base(resolve_llm_api_base()))
except ModelProfileError:
    print("(configured endpoint is unusable)")' 2>/dev/null || echo "(unavailable)"
}

refuse_unprofiled_phase_one_run() {
  # Every real phase-one row must come from a supported profile, whether the command named another
  # model, named none at all, or passed an empty --model-profile=.
  [[ -z "$LAUNCH_PROFILE" ]] || return 0
  if is_phase_one_suite "$LAUNCH_SUITE"; then
    if [[ -n "$LAUNCH_MODELS" ]]; then
      die "run: --models cannot execute the phase-one suite; use --profile PROFILE"
    fi
    die "run: a real run of the phase-one suite needs --profile PROFILE"
  fi
}

bind_model_profile() {
  local what="$1" profile="$2" profile_info profile_credential_env profile_base profile_key
  [[ -n "$profile" ]] || return 0
  profile_info="$("$PY" -c 'import sys
from ckbbench.run.model_profile import load_run_profile
p = load_run_profile(sys.argv[1])
print(f"{p.credential_env}\t{p.api_base}")' "$profile")" \
    || die "$what: $profile is not a supported model profile"
  IFS=$'\t' read -r profile_credential_env profile_base <<<"$profile_info"
  [[ "$profile_credential_env" == "CKBBENCH_LLM_API_KEY" ]] \
    || die "$what: the selected profile names an unsupported credential channel"
  profile_key="${!profile_credential_env:-sk-noauth}"
  LLM_BASE="$profile_base"
  export CKBBENCH_LLM_API_BASE="$profile_base"
  export CKBBENCH_LLM_API_KEY="$profile_key"
}

cmd_models() {
  "$PY" -c 'from ckbbench.run.model_profile import available_run_profiles
print("PROFILE\tMODEL\tAPI STYLE\tEXTENSIONS\tTHINKING")
for alias, profile in available_run_profiles():
    extensions = ",".join(sorted(profile.request_body_extensions)) or "none"
    print(f"{alias}\t{profile.requested_model}\t{profile.api_style}\t{extensions}\t{profile.thinking_level}")'
}

cmd_smoke() {
  local model="${CKBBENCH_SMOKE_MODEL:-}"
  local profile="${CKBBENCH_MODEL_PROFILE:-}"
  local keep=0 force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model-profile|--profile) profile="${2:-}"; shift 2 ;;
      --model) model="${2:-}"; shift 2 ;;
      --keep) keep=1; shift ;;
      --force) force=1; shift ;;
      -h|--help)
        info "usage: ckbbench smoke --profile PROFILE [--keep] [--force]"
        info "  One live matrix cell (arm B, seed 1, full suite tasks). Not free LLM-wise."
        info "  --profile accepts a name from './bench models' or a configs/models JSON path."
        info "  The profile fixes the model, endpoint,"
        info "  model settings and retry policy, and records them in the result (ADR-0014)."
        info "  --model NAME is refused: smoke always runs a real cell of the phase-one suite."
        return 0
        ;;
      *) die "smoke: unknown arg $1" ;;
    esac
  done
  if [[ -n "$profile" && -n "$model" ]]; then
    die "smoke: --model-profile and --model are mutually exclusive"
  fi
  # Smoke is hardwired to the phase-one suite and always spends a real cell, so a free-form model
  # can never be a development-only path here.
  [[ -z "$model" ]] || \
    die "smoke: --model cannot run the phase-one suite; use --profile PROFILE"
  [[ -n "$profile" ]] || die "smoke requires --profile PROFILE"

  bind_model_profile "smoke" "$profile"

  with_lock "smoke"
  if [[ "$force" -ne 1 ]]; then
    preflight_live 1
  else
    info "WARN: --force skips preflight"
  fi

  safe_wipe_smoke_dir
  mkdir -p "$OUTPUT_ROOT/smoke/results" "$OUTPUT_ROOT/smoke/site"

  export CKBBENCH_DOCKER=1
  export CKBBENCH_LLM_API_BASE="$LLM_BASE"
  local args=(
    --suite suites/ckb-v1
    --arms B
    --seeds 1
    --results-dir benchmark-output/smoke/results
    --site-dir benchmark-output/smoke/site
  )
  if [[ -n "$profile" ]]; then
    args+=(--model-profile "$profile")
  else
    args+=(--models "$model")
  fi
  if [[ "$keep" -eq 1 ]]; then
    args+=(--keep)
  fi
  info "== smoke: one cell ${profile:+profile=$profile}${model:+model=$model} arm=B seed=1 (all suite tasks) =="
  info "results: benchmark-output/smoke/results/"
  set +e
  bash "$REPO/scripts/run-matrix.sh" "${args[@]}"
  local rc=$?
  set -e
  release_lock
  return "$rc"
}

cmd_run() {
  local docker_mode="${CKBBENCH_DOCKER:-}"
  local force=0
  local launch_args=()
  local need_mcp=1
  local arms_seen=""
  local run_profile=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --docker) docker_mode=1; shift ;;
      --no-docker) docker_mode=0; shift ;;
      --force) force=1; shift ;;
      --) shift; launch_args+=("$@"); break ;;
      -h|--help)
        info "usage: ckbbench run [--docker|--no-docker] [--force] [run-matrix args]"
        info "  phase one:  ckbbench run --profile gpt-5.6-luna \\"
        info "                --arms B,C --seeds 1,2,3"
        info "  suites/ckb-v1 is the default; --suite may select another registry explicitly."
        info "  --models is development/dry-run only and cannot run the phase-one suite live."
        return 0
        ;;
      *) launch_args+=("$1"); shift ;;
    esac
  done

  scan_launch_args "${launch_args[@]+"${launch_args[@]}"}"
  if [[ -z "$LAUNCH_SUITE" ]]; then
    launch_args=(--suite suites/ckb-v1 "${launch_args[@]+"${launch_args[@]}"}")
    scan_launch_args "${launch_args[@]}"
  fi
  # Checked before the profile is loaded, before the dry-run branch and before the lock: a command
  # naming two model sources is invalid for every run, and must not reach a live endpoint first.
  if [[ -n "$LAUNCH_PROFILE" && -n "$LAUNCH_MODELS" ]]; then
    die "run: --model-profile and --models are mutually exclusive"
  fi
  run_profile="$LAUNCH_PROFILE"
  arms_seen="$LAUNCH_ARMS"

  # default docker on for production path if unset
  if [[ -z "$docker_mode" ]]; then
    docker_mode=1
  fi

  # MCP preflight: if arms known and only A/B (no C/D), still check MCP? A/B are no-MCP.
  # Plan: if arms cannot be resolved, check MCP always. If arms only A/B, skip MCP.
  if [[ -n "$arms_seen" ]]; then
    need_mcp=0
    if [[ "$arms_seen" == *C* || "$arms_seen" == *D* ]]; then
      need_mcp=1
    fi
  else
    need_mcp=1
  fi

  # A dry run inspects the grid and the profile; it starts no cell, so it must not hold the project
  # lock or contact Docker, the LLM proxy, MCP or the chain to do it.
  if [[ "$LAUNCH_DRY" -eq 1 ]]; then
    bind_model_profile "run" "$run_profile"
    export CKBBENCH_LLM_API_BASE="$LLM_BASE"
    info "== run matrix (dry run: no lock, no preflight) =="
    bash "$REPO/scripts/run-matrix.sh" "${launch_args[@]+"${launch_args[@]}"}"
    return $?
  fi

  refuse_unprofiled_phase_one_run
  bind_model_profile "run" "$run_profile"

  with_lock "run"
  if [[ "$force" -ne 1 ]]; then
    if [[ "$docker_mode" == "1" ]]; then
      preflight_live "$need_mcp"
    else
      # non-docker: still need LLM; MCP if needed; stack optional
      local llm_line
      set +e
      llm_line="$(llm_readiness)"
      local llm_rc=$?
      set -e
      [[ $llm_rc -eq 0 ]] || die "LLM readiness failed: ${llm_line:-check failed}"
      if [[ "$need_mcp" -eq 1 && "$MCP_DISABLE" != "1" ]]; then
        mcp_preflight >/dev/null || die "MCP preflight failed"
      fi
    fi
  fi

  if [[ "$docker_mode" == "1" ]]; then
    export CKBBENCH_DOCKER=1
  else
    export CKBBENCH_DOCKER=0
  fi
  export CKBBENCH_LLM_API_BASE="$LLM_BASE"

  info "== run matrix =="
  set +e
  bash "$REPO/scripts/run-matrix.sh" "${launch_args[@]}"
  local rc=$?
  set -e
  release_lock
  return "$rc"
}

cmd_diagnose() {
  # Exceptional troubleshooting, NOT a benchmark arm. Fixed after profile selection to suite 3.0.0,
  # arm B, seed 1, MCP off, one agent. It never grades, never writes a RunResult, and no report
  # reads what it produces. Every knob a benchmark run exposes is deliberately absent: an override
  # here would make the diagnostic describe something other than the accepted path.
  local artifact_root="$OUTPUT_ROOT" profile="${CKBBENCH_MODEL_PROFILE:-gpt-5.6-luna}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --artifact-root) artifact_root="${2:-}"; shift 2 ;;
      --model-profile|--profile) profile="${2:-}"; shift 2 ;;
      -h|--help)
        info "usage: ckbbench diagnose [--artifact-root <dir>] [--profile PROFILE]"
        info "  Runs ONE no-grade arm-B diagnostic cell and writes a bounded, content-free"
        info "  diagnostic under benchmark-output/ by default. Requires separate explicit"
        info "  authorization to run live."
        info "  No arm, seed, model, endpoint, image, retry, MCP or ceiling override exists."
        return 0
        ;;
      *) die "diagnose: unexpected argument: $1" ;;
    esac
  done

  [[ -n "$artifact_root" ]] || die "diagnose: --artifact-root cannot be empty"

  bind_model_profile "diagnose" "$profile"
  export CKBBENCH_LLM_API_BASE="$LLM_BASE"
  export CKBBENCH_MODEL_PROFILE="$profile"

  # No --force: skipping a check is not an override this command offers. There is deliberately NO
  # readiness preflight here: `preflight_live` requires running DevNet services, while the
  # diagnostic transition requires them stopped. The lock is held across the whole command, and the
  # supervisor starts its 600 s deadline before its first external action.
  with_lock "diagnose"
  info "== diagnose (no grading, no result row, one arm-B cell) =="
  CKBBENCH_DOCKER=1 "$PY" -m ckbbench.run.diagnose_cli --artifact-root "$artifact_root"
}

cmd_unlock() {
  ensure_lock_dir
  local opid
  opid="$(meta_pid || true)"
  if [[ -z "${opid:-}" ]]; then
    info "no owner metadata; lock free or unused"
    resolve_lock_backend
    eval "exec ${LOCK_FD}>>\"\$LOCK_FILE\""
    if lock_take; then
      info "lock is free"
      lock_drop
      return 0
    fi
    info "lock held but no metadata (another process); refuse to force-release another holder"
    return 1
  fi
  if pid_alive "$opid"; then
    die "lock owner pid $opid is still alive. Stop that process (or wait). unlock does not kill live holders"
  fi
  info "clearing stale metadata for dead pid $opid"
  clear_owner_meta
  info "unlock OK (metadata cleared; the lock releases when its holder process exits)"
}

cmd_help() {
  printf '%s\n' 'ckbbench — operator CLI for CKB AI Bench

Commands:
  setup              Create venv, install deps, seed .env
  up [--no-build]    Build images + start proxy/devnet on a prepared DevNet chain
  down               Stop compose stack (proxy/devnet); DevNet chain state is retained
  clean [--caches]   Remove agent leftovers (not compose services)
  reset [--caches] [--wipe-out]
                     down + clean + remove the benchmark-owned DevNet chain state
                     (foreign volumes are never touched); optional wipe benchmark-output/smoke/
  status             PASS/FAIL/SKIP readiness checks
  test [--docker]    Harness tests (pytest; --docker adds container proof)
  models              List selectable model profiles
  smoke --profile P   One live cell (arm B, seed 1); output under benchmark-output/smoke/
                     P is a profile name from `./bench models` or a configs/models path.
                     --model NAME is refused: smoke always spends a real phase-one cell.
  run [opts] -- ...  Full matrix (pass-through to run-matrix.sh)
  unlock             Clear stale lock metadata (dead pid only)

DevNet state: every Docker DevNet cell is prepared on a freshly generated chain, so no manual
step is needed between cells. `down` keeps the chain for the next `up`; `reset` removes the
benchmark-owned volume (a same-named foreign volume is never touched). `smoke --keep` (or
CKBBENCH_KEEP=1) retains per-cell debugging leftovers only -- the next cell still starts fresh.

Day-1 (primary entrypoint is ./bench at repo root):
  ./bench setup
  ./bench test
  ./bench up
  ./bench status
  ./bench models
  ./bench smoke --profile gpt-5.6-luna
  ./bench reset

Troubleshooting (not a benchmark arm; needs separate authorization to run live):
  ./bench diagnose                        one no-grade arm-B cell + bounded diagnostic

Env (optional): CKBBENCH_LLM_API_KEY, CKBBENCH_MCP_URL, CKBBENCH_MODEL_PROFILE,
  CKBBENCH_SMOKE_MODEL, CKBBENCH_DOCKER, CKBBENCH_KEEP,
  CKBBENCH_MCP_DISABLE=1 to skip MCP checks,
  CKBBENCH_LOCK_BACKEND=auto|flock|python (auto picks flock when installed).'
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    setup) cmd_setup "$@" ;;
    up) cmd_up "$@" ;;
    down) cmd_down "$@" ;;
    clean) cmd_clean "$@" ;;
    reset) cmd_reset "$@" ;;
    status) cmd_status "$@" ;;
    test) cmd_test "$@" ;;
    models) cmd_models "$@" ;;
    smoke) cmd_smoke "$@" ;;
    run) cmd_run "$@" ;;
    diagnose) cmd_diagnose "$@" ;;
    unlock) cmd_unlock "$@" ;;
    -h|--help|help|"") cmd_help ;;
    *) die "unknown command: $cmd (try: ./bench help)" ;;
  esac
}

# Sourcing this file exposes the helpers (lock tests) without running a command.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
