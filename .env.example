# CKB AI Bench - environment overrides (copy to .env for local use; .env is gitignored).
#
# Every key below is read by ckbbench/config.py (the single source of truth). All have working
# defaults, so a fresh checkout runs without a .env; set a key only to retarget a run without
# editing code. Each new CKBBENCH_* name also accepts the legacy name in (parens) that the
# agent fork and spikes already use.
#
# These are NOT secrets. DevNet genesis keys are public dev.toml test keys (ADR-0007).

# --- LLM proxy (OpenAI-compatible; recommend openai + grok models) ---
# CKBBENCH_LLM_API_BASE=http://localhost:18321/v1      # (BENCH_API_BASE)
# CKBBENCH_LLM_API_KEY=sk-noauth                        # (BENCH_API_KEY)

# --- MCP server under test (version pinned + preflight-enforced, ADR-0010) ---
# CKBBENCH_MCP_URL=https://mcp.ckbdev.com/ckbai          # (MCP_URL) live dev default
# CKBBENCH_MCP_VERSION=1.6.12                            # (MCP_PINNED_VERSION)

# --- Chain RPC endpoints (DevNet + TestNet scored separately) ---
# Defaults are addresses as seen FROM THE HARNESS HOST. Inside the docker network the
# orchestrator overrides DEVNET_RPC with the sidecar's compose service name.
# CKBBENCH_DEVNET_RPC=http://127.0.0.1:8114
# CKBBENCH_TESTNET_RPC=http://192.168.0.73:18114

# --- Container images (pin at release; supports repo:tag or repo@sha256:...) ---
# CKBBENCH_AGENT_IMAGE=ckbbench-agent:latest
# CKBBENCH_VERIFIER_IMAGE=ckbbench-verifier:latest

# --- TestNet signing (operator secret; gitignored via .env) ---
# Funded sender private key for task-04-send-tx. Forwarded into the docker agent when
# CKBBENCH_DOCKER=1 so the model can sign without MCP faucet tools.
# CKBBENCH_TESTNET_SENDER_PRIVKEY=0x...
